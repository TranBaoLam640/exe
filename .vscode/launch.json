{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DoRentMe Full Stack",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Start Frontend",
      "program": "${workspaceFolder}/backend/DoRentMe.Api/bin/Debug/net9.0/DoRentMe.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/DoRentMe.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "http://localhost:5173"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "DoRentMe Backend Only",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/backend/DoRentMe.Api/bin/Debug/net9.0/DoRentMe.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/DoRentMe.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    }
  ]
}
